# Supabase (same project style as the rest of Leo's stack — but its own
# "cloudapp" schema so it never touches Nextcloud's tables)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Cloudflare R2 (S3-compatible). Same bucket style as Nextcloud's
# OBJECTSTORE_S3_* env vars — reuse those values here.
R2_ACCOUNT_ID=xxxxxxxx
R2_BUCKET=minha-nuvem
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com

# Public app URL (used to build share links)
NEXT_PUBLIC_APP_URL=https://app.sinmpla.com.br
